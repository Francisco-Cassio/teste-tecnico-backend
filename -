          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Especialista'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Especialista'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Especialista'
          description: ''
  /api/especialistas/{id}/:
    get:
      operationId: especialistas_retrieve
      parameters:
