openapi: 3.0.3
info:
  title: API Clínica Médica - Agendamento de Consultas
  version: 1.0.0
  description: Documentação OpenAPI 3.0 dos endpoints de autenticação, especialistas,
    agendas e consultas.
paths:
  /api/agendas/:
    get:
      operationId: agendas_list
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - agendas
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAgendaList'
          description: ''
    post:
      operationId: agendas_create
      tags:
      - agendas
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Agenda'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Agenda'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Agenda'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Agenda'
          description: ''
  /api/agendas/{id}/:
    get:
      operationId: agendas_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this agenda.
        required: true
      tags:
      - agendas
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Agenda'
          description: ''
    put:
      operationId: agendas_update
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this agenda.
        required: true
      tags:
      - agendas
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Agenda'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Agenda'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Agenda'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Agenda'
          description: ''
    patch:
      operationId: agendas_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this agenda.
        required: true
      tags:
      - agendas
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAgenda'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAgenda'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAgenda'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Agenda'
          description: ''
    delete:
      operationId: agendas_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this agenda.
        required: true
      tags:
      - agendas
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/especialistas/:
    get:
      operationId: especialistas_list
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
